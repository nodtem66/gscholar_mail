# AgentMail credentials and inbox
AGENTMAIL_API_KEY=replace-with-agentmail-api-key
AGENTMAIL_INBOX=gscholar@agentmail.to

# Local SQLite databases (DATABASE_PATH is shared by the web app and MCP server)
DATABASE_PATH=data/publications.db
MAIL_DATABASE_PATH=data/mail.db

# Local web server
BIND_HOST=127.0.0.1
BIND_PORT=8000
DASHBOARD_PASSWORD=replace-with-a-strong-password
